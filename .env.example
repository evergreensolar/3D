# ---------- Core ----------
DATABASE_URL="postgresql://evergreen:evergreen@localhost:5432/evergreen?schema=public"
# Public base URL used in links, QR codes and messages (no trailing slash)
APP_URL="http://localhost:3000"
# Long random strings: `openssl rand -base64 48`
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
TZ_DEFAULT="Asia/Kolkata"

# ---------- Storage ----------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# For s3 (AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces ...)
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com or http://localhost:9000 (MinIO)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false" # true for MinIO

# ---------- Messaging ----------
# SMS: console | msg91 | twilio
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""   # DLT-approved OTP template (India)
MSG91_SENDER_ID="EVGSOL"
MSG91_FLOW_TEMPLATE_ID=""  # DLT-approved generic template with ##message## var
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# WhatsApp: console | meta | gupshup | webhook
WHATSAPP_PROVIDER="console"
META_WA_TOKEN=""
META_WA_PHONE_NUMBER_ID=""
GUPSHUP_API_KEY=""
GUPSHUP_SOURCE_NUMBER=""
GUPSHUP_APP_NAME=""
WHATSAPP_WEBHOOK_URL=""    # generic: POSTs {to, text, mediaUrl} as JSON
WHATSAPP_WEBHOOK_TOKEN=""

# Email: console | smtp
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Evergreen Solar <design@evergreensolar.example>"

# ---------- Processing worker ----------
# Path to a Chromium binary for headless rendering (leave empty to let Playwright find it)
CHROMIUM_PATH=""
# Dev only: show OTP codes in the UI/API response when SMS_PROVIDER=console
DEV_SHOW_OTP="true"
