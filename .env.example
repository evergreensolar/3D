# ===== REQUIRED (only these 5 are needed to start) =====
# PostgreSQL connection string (e.g. Supabase → Connect → "Session pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Public address of the site, no trailing slash
APP_URL="https://your-domain.com"
# Any random text of at least 32 characters
SESSION_SECRET="replace-with-at-least-32-random-characters-xxxx"
# First admin login (created on first sign-in when the database has no users)
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="change-this-password"

# ===== OPTIONAL — everything below has defaults; uncomment only what you use =====
# DEV_SHOW_OTP="true"          # show OTP on screen while SMS_PROVIDER=console (testing only)
# STORAGE_DRIVER="local"       # local | s3
# STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="ap-south-1"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# SMS_PROVIDER="console"       # console | msg91 | twilio
# MSG91_AUTH_KEY=""
# MSG91_OTP_TEMPLATE_ID=""
# MSG91_FLOW_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# WHATSAPP_PROVIDER="console"  # console | meta | webhook
# META_WA_TOKEN=""
# META_WA_PHONE_NUMBER_ID=""
# WHATSAPP_WEBHOOK_URL=""
# WHATSAPP_WEBHOOK_TOKEN=""
# EMAIL_PROVIDER="console"     # console | smtp
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="Evergreen Solar <design@your-domain.com>"
# CHROMIUM_PATH=""             # worker only
